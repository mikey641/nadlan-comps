{
  "name": "nadlan-comps",
  "version": "0.1.0",
  "description": "Comparable-sales and rent valuations for a single Israeli property, from GovMap (Tax Authority deals), nadlan.gov.il, Madlan and Yad2 — one function call.",
  "keywords": [
    "israel",
    "real-estate",
    "valuation",
    "comps",
    "comparables",
    "nadlan",
    "govmap",
    "madlan",
    "yad2",
    "rent",
    "scraper",
    "נדלן"
  ],
  "license": "MIT",
  "author": "Michael Hasson",
  "homepage": "https://github.com/mikey641/nadlan-comps#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikey641/nadlan-comps.git"
  },
  "bugs": {
    "url": "https://github.com/mikey641/nadlan-comps/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nadlan-comps": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "NADLAN_COMPS_LIVE=1 vitest run test/live.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "patchright": ">=1.50.0",
    "playwright": ">=1.45.0"
  },
  "peerDependenciesMeta": {
    "patchright": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "patchright": "^1.55.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
